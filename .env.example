# DEV
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starter_template_hono
BETTER_AUTH_SECRET="your-long-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:8787"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
PUBLIC_URL="http://127.0.0.1:3000/api/v1/files/public"

# Cloudflare-backed services for the homelab runtime
DATABASE_DRIVER=pg
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_AI_API_TOKEN="your-workers-ai-api-token"
R2_ENDPOINT="https://your-cloudflare-account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="your-r2-bucket"
